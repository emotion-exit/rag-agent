# SiliconFlow (硅基流动) - for embeddings
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=your_embedding_api_base_url_here
EMBEDDING_MODEL=your_embedding_model_here
EMBEDDING_PROVIDER=openai

RERANKER_API_KEY=your_reranker_api_key_here
RERANKER_BASE_URL=your_reranker_api_base_url_here
RERANKER_MODEL=your_reranker_model_here
RERANKER_REQUEST_TIMEOUT=20

# OpenRouter - for QA / chat
CHAT_API_KEY=your_api_key_here
CHAT_BASE_URL=your_chat_api_base_url_here
CHAT_MODEL=your_chat_model_here
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_TITLE=RAG.Agent Local
OPENROUTER_CATEGORIES=general-chat

# ChromaDB vector store path
CHROMA_PERSIST_DIR=./data/chroma

# File upload directory
UPLOAD_DIR=./data/uploads

# Knowledge base background job retention
KNOWLEDGE_BASE_JOB_RETENTION_HOURS=2
KNOWLEDGE_BASE_JOB_HISTORY_LIMIT=10

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
