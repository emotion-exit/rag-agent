{
  "name": "frontend",
  "version": "0.0.0",
  "description": "RAG.Agent desktop frontend with Electron shell and bundled Python backend",
  "author": "cattee1213",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "desktop:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron ./electron/main.mjs",
    "desktop:dev": "run-p dev desktop:electron",
    "desktop:backend:build": "cd ../backend && uv run --with pyinstaller pyinstaller rag_agent_backend.spec --noconfirm",
    "desktop:build": "node ./scripts/build-desktop.mjs current",
    "desktop:build:mac": "node ./scripts/build-desktop.mjs mac",
    "desktop:build:win": "node ./scripts/build-desktop.mjs win"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@types/uuid": "^10.0.0",
    "axios": "^1.13.6",
    "markdown-it": "^14.1.1",
    "uuid": "^13.0.0",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.11.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/tsconfig": "^0.8.1",
    "cross-env": "^10.1.0",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "npm-run-all2": "^8.0.4",
    "tailwindcss": "4.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vue-tsc": "^3.2.5",
    "wait-on": "^8.0.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "build": {
    "appId": "cattee1213.rag-agent",
    "productName": "RAG.Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "public/favicon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/rag-agent-backend",
        "to": "backend"
      }
    ],
    "mac": {
      "icon": "electron/assets/icon.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "electron/assets/icon.png",
      "target": [
        "portable"
      ]
    }
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c"
}
